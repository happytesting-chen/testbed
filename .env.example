# Copy to .env (git-ignored) and fill in. Never commit real values.
# Generate tokens with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
ANALYST_TOKEN=
CONTRIBUTOR_TOKEN=
EVALUATOR_TOKEN=

# OpenAI-compatible chat completions gateway (base URL without /chat/completions)
LLM_BASE_URL=https://nc3.csa.gov.sg/kepler/v1
LLM_API_KEY=
LLM_API_KEY_HEADER=x-api-key
LLM_MODEL=bedrock.claude-sonnet-4-0
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=90
AGENT_MAX_STEPS=6

# TESTBED_DATA_DIR=./data
