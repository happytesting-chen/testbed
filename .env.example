# Copy to .env (git-ignored) and fill in. Never commit real values.
# Generate tokens with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
ANALYST_TOKEN=
MANAGER_TOKEN=
EVALUATOR_TOKEN=

# ── LLM Provider Selection ──────────────────────────────────────────────────
# Set to "openai" for OpenAI-compatible gateway, or "bedrock" for Amazon Bedrock
LLM_PROVIDER=bedrock

# ── OpenAI-Compatible Provider (LLM_PROVIDER=openai) ────────────────────────
# LLM_BASE_URL=https://your-gateway/v1
# LLM_API_KEY=
# LLM_API_KEY_HEADER=x-api-key
# LLM_MODEL=bedrock.claude-sonnet-4-0

# ── Amazon Bedrock Provider (LLM_PROVIDER=bedrock) ──────────────────────────
AWS_REGION=ap-southeast-1

# Authentication — use ONE of:
# Option 1: Bearer token (SSO/temporary credentials)
# AWS_BEARER_TOKEN_BEDROCK=
# Option 2: Access key (set via env or ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Option 3: IAM role (EC2) — no credentials needed, boto3 auto-discovers

# Default model for all agents (foundation model ID or inference profile ID)
BEDROCK_DEFAULT_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional: per-agent model overrides (leave blank to use default)
# BEDROCK_COORDINATOR_MODEL_ID=
# BEDROCK_DOCUMENT_READER_MODEL_ID=
# BEDROCK_FINDINGS_MANAGER_MODEL_ID=

# ── Common Settings ─────────────────────────────────────────────────────────
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=90
AGENT_MAX_STEPS=6

# TESTBED_DATA_DIR=./data
